<?xml version="1.0" encoding="utf-8"?>
<!-- Optional SpriteFont. Bitmap fonts are used at runtime for reliability.
     To switch: build this via Content.mgcb and Content.Load<SpriteFont>("Fonts/UiFont"). -->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>24</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
